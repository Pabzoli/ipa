# Deploy-time flag: exports the Identity Platform blocking functions
# (beforeEmailSent / beforeUserSignedIn). They are the server-side throttle
# layer for verification/reset emails and sign-in lockouts.
#
# Identity Platform is enabled on anime-quiz-1ab1b, so these are deployed.
# Removing this file would make the next `firebase deploy --only functions`
# treat them as deleted. The advisory callables (requestEmailVerification /
# checkAuthAttempt) remain as the client-facing layer either way.
ENABLE_IDENTITY_BLOCKING=true
